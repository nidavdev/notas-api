# Copia este archivo como ".env" (en la carpeta jenkins/) y cambia los valores:
#   cp .env.example .env
# El archivo .env NO se sube a Git.

# Usuario administrador de Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambia_esta_contrasena_de_jenkins

# Credenciales de PostgreSQL que Jenkins guardará (id: postgres-credentials)
POSTGRES_USER=notes_user
POSTGRES_PASSWORD=cambia_esta_contrasena_de_postgres
